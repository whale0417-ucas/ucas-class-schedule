        android:id="@+id/widget_status"
        android:layout_width="match_parent"
        android:layout_height="18dp"
        android:gravity="center"
        android:text="点击课表打开 App"
        android:textSize="7sp"
        android:maxLines="1"
        android:ellipsize="end" />

</LinearLayout>
